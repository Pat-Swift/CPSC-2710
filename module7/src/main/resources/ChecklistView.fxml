<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="cpsc.module7.ChecklistViewController"
            prefWidth="700" prefHeight="400">

    <center>
        <HBox spacing="20.0" alignment="CENTER" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <Label text="Need to Pack"/>
                        <ListView fx:id="needToPackList" prefWidth="250" prefHeight="300"/>
                    </children>
                </VBox>

                <VBox spacing="10.0" alignment="CENTER">
                    <children>
                        <Button text="Add to Packed →" onAction="#handleAddToPacked"/>
                        <Button text="← Remove from Packed" onAction="#handleRemoveFromPacked"/>
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Label text="Packed Items"/>
                        <ListView fx:id="packedList" prefWidth="250" prefHeight="300"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>
</BorderPane>
