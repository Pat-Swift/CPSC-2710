<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cpsc.module7.MainMenuController"
      fx:id="rootPane"
      alignment="CENTER"
      spacing="20.0"
      prefHeight="300.0" prefWidth="400.0"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="40.0" bottom="40.0" left="40.0" right="40.0"/>
    </padding>

    <children>
        <Label text="🏕️ Camping Checklist Launcher" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <Button text="Open Packing List" onAction="#openPackingList" prefWidth="200"/>
        <Button text="Open Dog List" onAction="#openDogList" prefWidth="200"/>
        <Button text="Open Food List" onAction="#openFoodList" prefWidth="200"/>
    </children>
</VBox>
